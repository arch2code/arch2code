# ignore __pycache__
__pycache__

# hide Microsoft Visual Studo workspaces
*.code-workspace
.vscode/

# hide .DS_Store, OSX image preview / cache files
**/.DS_Store

# ignore .gv, .svg, and .gv.svg files since they are output from graphviz usage
gv_out/*.gv
gv_out/*.svg

# ignore .pu, .png, and .svg files since they are output from plantuml usage
pu_out/*.pu
pu_out/*.png
pu_out/*.svg

# ignore document/build
document/build/*

# ignore output package.f file
systemVerilog/mixed/package.f
systemVerilog/apbDecode/package.f
systemVerilog/axiDemo/package.f

# ignore the test output directory
tests/out/*

# ignore regression output directories
**/regr/**

# VCS and Xcelium output in a project rundir. *.log and *.d already cover the
# logs and the xcelium_<topology>.d snapshots.
**/rundir/build_xrun/
**/rundir/xrun*.history
**/rundir/AN.DB/
**/rundir/csrc/
**/rundir/vc_hdrs.h
**/rundir/ucli.key

# database files
*.db

# cpp files
**/build/*
*.log
*.o
*.d

# gen files
*.scgen
*.svgen
.clangd
compile_commands.json
.gen/
**/.gen/**
.cache/
**/.cache/**
.container-prerequisites

# generated AI agent rule/skill deployments (make agents-setup / agent-dev-setup)
.claude/
.gemini/
.opencode/
.agents/
.cursor/
.cursorrules
GEMINI.md
.agents-setup.md5

# test_vl_boundary_widths_build.py working copy, removed after each run
unittest/vl_boundary_widths_*/
