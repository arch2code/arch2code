{
    "session": {
        "name": "regr_uvmVideo_uvm_vcs",
        "jobs": 3,
        "lrp": 0
    },
    "build": {
        "command": "make -j8 USE_UVM=1 USE_VCS=1 uvm_snapshots",
        "timeout": 1800
    },
    "run": {
        "command": "/usr/bin/time -f CPU_TIME_USER=%U ../../../dutRun.py build/run uvmVideo_uvm",
        "args": "--seed ${RL_SEED} --verbosity=low --uvmTop uvmVideo",
        "timeout": 900,
        "rules": [
            "../../../config/regrRules/uvm.json",
            "default.json",
            "vcs.json"
        ],
        "count": 1,
        "seed": 1,
        "labels": [
            "uvm"
        ],
        "model_dut": {
            "args+": "--uvmDut model",
            "labels+": [
                "mdl"
            ],
            "test_group": {
                "uvmVideo_smoke_test": {
                    "args+": "+UVM_TESTNAME=uvmVideo_smoke_test"
                },
                "uvmVideo_video_test_blanking": {
                    "args+": "+UVM_TESTNAME=uvmVideo_video_test_blanking",
                    "count": 3,
                    "seed": "random"
                },
                "uvmVideo_video_test_back_to_back": {
                    "args+": "+UVM_TESTNAME=uvmVideo_video_test_back_to_back"
                },
                "uvmVideo_video_test_short_line": {
                    "args+": "+UVM_TESTNAME=uvmVideo_video_test_short_line"
                },
                "uvmVideo_video_test_long_line": {
                    "args+": "+UVM_TESTNAME=uvmVideo_video_test_long_line"
                },
                "uvmVideo_video_test_cut_frame": {
                    "args+": "+UVM_TESTNAME=uvmVideo_video_test_cut_frame"
                },
                "uvmVideo_video_test_cut_lv_high": {
                    "args+": "+UVM_TESTNAME=uvmVideo_video_test_cut_lv_high"
                },
                "uvmVideo_video_test_fv_rise_line": {
                    "args+": "+UVM_TESTNAME=uvmVideo_video_test_fv_rise_line"
                },
                "uvmVideo_video_test_lv_vblank": {
                    "args+": "+UVM_TESTNAME=uvmVideo_video_test_lv_vblank"
                },
                "uvmVideo_video_test_random": {
                    "args+": "+UVM_TESTNAME=uvmVideo_video_test_random",
                    "count": 3,
                    "seed": "random"
                },
                "uvmVideo_fail_test": {
                    "args+": "+UVM_TESTNAME=uvmVideo_fail_test"
                }
            }
        },
        "rtl_dut": {
            "args+": "--uvmDut rtl",
            "labels+": [
                "hdl"
            ],
            "test_group": {
                "uvmVideo_smoke_test": {
                    "args+": "+UVM_TESTNAME=uvmVideo_smoke_test"
                },
                "uvmVideo_video_test_blanking": {
                    "args+": "+UVM_TESTNAME=uvmVideo_video_test_blanking",
                    "count": 3,
                    "seed": "random"
                },
                "uvmVideo_video_test_back_to_back": {
                    "args+": "+UVM_TESTNAME=uvmVideo_video_test_back_to_back"
                },
                "uvmVideo_video_test_short_line": {
                    "args+": "+UVM_TESTNAME=uvmVideo_video_test_short_line"
                },
                "uvmVideo_video_test_long_line": {
                    "args+": "+UVM_TESTNAME=uvmVideo_video_test_long_line"
                },
                "uvmVideo_video_test_cut_frame": {
                    "args+": "+UVM_TESTNAME=uvmVideo_video_test_cut_frame"
                },
                "uvmVideo_video_test_cut_lv_high": {
                    "args+": "+UVM_TESTNAME=uvmVideo_video_test_cut_lv_high"
                },
                "uvmVideo_video_test_fv_rise_line": {
                    "args+": "+UVM_TESTNAME=uvmVideo_video_test_fv_rise_line"
                },
                "uvmVideo_video_test_lv_vblank": {
                    "args+": "+UVM_TESTNAME=uvmVideo_video_test_lv_vblank"
                },
                "uvmVideo_video_test_random": {
                    "args+": "+UVM_TESTNAME=uvmVideo_video_test_random",
                    "count": 3,
                    "seed": "random"
                },
                "uvmVideo_fail_test": {
                    "args+": "+UVM_TESTNAME=uvmVideo_fail_test"
                }
            }
        },
        "both_dut": {
            "args+": "--uvmDut both",
            "labels+": [
                "both"
            ],
            "test_group": {
                "uvmVideo_smoke_test": {
                    "args+": "+UVM_TESTNAME=uvmVideo_smoke_test"
                },
                "uvmVideo_video_test_blanking": {
                    "args+": "+UVM_TESTNAME=uvmVideo_video_test_blanking",
                    "count": 3,
                    "seed": "random"
                },
                "uvmVideo_video_test_back_to_back": {
                    "args+": "+UVM_TESTNAME=uvmVideo_video_test_back_to_back"
                },
                "uvmVideo_video_test_short_line": {
                    "args+": "+UVM_TESTNAME=uvmVideo_video_test_short_line"
                },
                "uvmVideo_video_test_long_line": {
                    "args+": "+UVM_TESTNAME=uvmVideo_video_test_long_line"
                },
                "uvmVideo_video_test_cut_frame": {
                    "args+": "+UVM_TESTNAME=uvmVideo_video_test_cut_frame"
                },
                "uvmVideo_video_test_cut_lv_high": {
                    "args+": "+UVM_TESTNAME=uvmVideo_video_test_cut_lv_high"
                },
                "uvmVideo_video_test_fv_rise_line": {
                    "args+": "+UVM_TESTNAME=uvmVideo_video_test_fv_rise_line"
                },
                "uvmVideo_video_test_lv_vblank": {
                    "args+": "+UVM_TESTNAME=uvmVideo_video_test_lv_vblank"
                },
                "uvmVideo_video_test_random": {
                    "args+": "+UVM_TESTNAME=uvmVideo_video_test_random",
                    "count": 3,
                    "seed": "random"
                },
                "uvmVideo_fail_test": {
                    "args+": "+UVM_TESTNAME=uvmVideo_fail_test"
                },
                "uvmVideo_model_mismatch_test": {
                    "args+": "+UVM_TESTNAME=uvmVideo_model_mismatch_test"
                }
            }
        }
    }
}
