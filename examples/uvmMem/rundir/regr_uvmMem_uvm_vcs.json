{
    "session": {
        "name": "regr_uvmMem_uvm_vcs",
        "jobs": 3,
        "lrp": 0
    },
    "build": {
        "command": "make -j8 USE_UVM=1 USE_VCS=1 uvm_snapshots",
        "timeout": 1800
    },
    "run": {
        "command": "/usr/bin/time -f CPU_TIME_USER=%U ../../../dutRun.py build/run uvmMem_uvm",
        "args": "--seed ${RL_SEED} --verbosity=low --uvmTop uvmMem",
        "timeout": 900,
        "rules": [
            "../../../config/regrRules/uvm.json",
            "default.json",
            "vcs.json"
        ],
        "count": 1,
        "seed": 1,
        "labels": [
            "uvm"
        ],
        "model_dut": {
            "args+": "--uvmDut model",
            "labels+": [
                "mdl"
            ],
            "test_group": {
                "uvmMem_smoke_test": {
                    "args+": "+UVM_TESTNAME=uvmMem_smoke_test"
                },
                "uvmMem_random_test": {
                    "args+": "+UVM_TESTNAME=uvmMem_random_test",
                    "count": 3,
                    "seed": "random"
                },
                "uvmMem_fail_test": {
                    "args+": "+UVM_TESTNAME=uvmMem_fail_test"
                }
            }
        },
        "rtl_dut": {
            "args+": "--uvmDut rtl",
            "labels+": [
                "hdl"
            ],
            "test_group": {
                "uvmMem_smoke_test": {
                    "args+": "+UVM_TESTNAME=uvmMem_smoke_test"
                },
                "uvmMem_random_test": {
                    "args+": "+UVM_TESTNAME=uvmMem_random_test",
                    "count": 3,
                    "seed": "random"
                },
                "uvmMem_fail_test": {
                    "args+": "+UVM_TESTNAME=uvmMem_fail_test"
                }
            }
        },
        "both_dut": {
            "args+": "--uvmDut both",
            "labels+": [
                "both"
            ],
            "test_group": {
                "uvmMem_smoke_test": {
                    "args+": "+UVM_TESTNAME=uvmMem_smoke_test"
                },
                "uvmMem_random_test": {
                    "args+": "+UVM_TESTNAME=uvmMem_random_test",
                    "count": 3,
                    "seed": "random"
                },
                "uvmMem_fail_test": {
                    "args+": "+UVM_TESTNAME=uvmMem_fail_test"
                },
                "uvmMem_model_mismatch_test": {
                    "args+": "+UVM_TESTNAME=uvmMem_model_mismatch_test"
                }
            }
        }
    }
}
